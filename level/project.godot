; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Game Project"
run/main_scene="uid://bffs0yqr2jdrx"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

QuestManager="*uid://cvgdrjrxomhpn"
personality="*uid://kyp34pfq0is5"
GameState="*uid://bg46une044fpm"
EndingManager="*uid://38n8bh0vy0ni"
BeehaveGlobalMetrics="*uid://c3ktl6ontsdt7"
BeehaveGlobalDebugger="*uid://bl3ma400hpvsh"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"MC": "res://addons/dialogic/characters/MC.dch",
"Mira": "res://addons/dialogic/characters/Mira.dch",
"Samyak": "res://addons/dialogic/characters/Samyak.dch",

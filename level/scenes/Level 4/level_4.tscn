[sub_resource type="GDScript" id="GDScript_tocb5"]
script/source = "extends Area2D

var player_near = false
@onready var player: CharacterBody2D = $\"../../Player\"
@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D

var talked = false
@onready var helper: Label = $\"../../CanvasLayer2/helper\"

func _ready():
	body_entered.connect(on_body_entered)
	body_exited.connect(on_body_exited)
	Dialogic.signal_event.connect(dialogic_signal)

func _process(_delta):
	if player_near and Input.is_action_just_pressed(\"interact\"):
		if !talked:
			run_dialogue(get_dialogue_for_personality())
			talked = true

func get_dialogue_for_personality() -> String:
	match personality.best_name:
		\"Aggressive\":
			return \"NPC1talkAgressive\"
		\"Brave\":
			return \"NPC1talkBrave\"
		\"Selfish\":
			return \"NPC1talkSelfish\"
		\"Empathy\":
			return \"NPC1talk\"
		_:
			return \"NPC1talk\"

func run_dialogue(dia):
	player.player_inte = true
	Dialogic.start(dia)
	await Dialogic.timeline_ended
	player.player_inte = false

func dialogic_signal(arg: String):
	match arg:
		\"NPC1_Empathy_choice1\":
			personality.update_personality([40, -20, -30, -10])
		\"NPC1_Empathy_choice2\":
			personality.update_personality([-25, 10, 15, -15])
		\"NPC1_Aggressive_choice1\":
			personality.update_personality([25, -10, -30, -15])
		\"NPC1_Aggressive_choice2\":
			personality.update_personality([-35, 15, 45, 20])
	# TODO: trigger combat here if this NPC turns hostile
			animated_sprite_2d.play(\"death\")
		\"NPC1_Selfish_choice1\":
			personality.update_personality([-35, 45, 15, -10])
		\"NPC1_Selfish_choice2\":
			personality.update_personality([5, 15, -5, -10])
		\"NPC1_Brave_choice1\":
			personality.update_personality([15, -15, -10, 30])
	# TODO: set subject_zero_hint flag
		\"NPC1_Brave_choice2\":
			personality.update_personality([5, -5, -5, 15])

func on_body_entered(body):
	if body.name == \"Player\":
		player_near = true
		helper.interact()

func on_body_exited(body):
	if body.name == \"Player\":
		player_near = false
		helper.nointeract()
"


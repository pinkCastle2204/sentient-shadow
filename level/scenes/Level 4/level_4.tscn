[sub_resource type="GDScript" id="GDScript_aa28g"]
script/source = "extends Area2D

var player_near = false
@onready var player: CharacterBody2D = $\"../../Player\"
var talked = false

func _ready():
	body_entered.connect(on_body_entered)
	body_exited.connect(on_body_exited)
	Dialogic.signal_event.connect(dialogic_signal)

func _process(_delta):
	if player_near and Input.is_action_just_pressed(\"interact\"):
		if !talked:
			run_dialogue(get_dialogue_for_personality())
			talked = true

func get_dialogue_for_personality() -> String:
	match personality.best_name:
		\"Aggressive\":
			return \"NPC2talkAgressive\"
		\"Brave\":
			return \"NPCtalk2Brave\"
		\"Selfish\":
			return \"NPCtalk2Selfish\"
		\"Empathy\":
			return \"NPC2talkEmpathy\"
		_:
			return \"NPC2talkEmpathy\"

func run_dialogue(dia):
	player.player_inte = true
	Dialogic.start(dia)
	await Dialogic.timeline_ended
	player.player_inte = false

func dialogic_signal(arg: String):
	match arg:
		\"NPC2_Empathy_choice1\":
			personality.update_personality([40, -25, -30, -10])
		\"NPC2_Empathy_choice2\":
			personality.update_personality([-20, 10, 15, -15])
		\"NPC2_Selfish_choice1\":
			personality.update_personality([-25, 35, 5, -15])
			# deal made, codes handed over — outcome still pending on next choice
		\"NPC2_Selfish_rescue_after_deal\":
			personality.update_personality([15, 10, -5, 0])
			# kept the deal — smaller swing since greed was already banked above
		\"NPC2_Selfish_betray\":
			personality.update_personality([-30, 40, 5, -15])
			# TODO: set broken_promise_pending flag — this scientist becomes a hostile witness later
		\"NPC2_Selfish_choice2\":
			personality.update_personality([10, 20, -5, -10])
		\"NPC2_Aggressive_choice1\":
			personality.update_personality([-25, 15, 40, 15])
			# TODO: set sublevel4_hint flag
		\"NPC2_Aggressive_choice2\":
			personality.update_personality([10, -10, 35, 20])
		\"NPC2_Brave_choice1\":
			personality.update_personality([20, -15, -10, 35])
			# TODO: set scientist_ally_recruited flag
		\"NPC2_Brave_choice2\":
			personality.update_personality([10, -5, -5, 20])
@onready var helper: Label = $\"../../CanvasLayer2/helper\"

func on_body_entered(body):
	if body.name == \"Player\":
		player_near = true
		helper.interact()

func on_body_exited(body):
	if body.name == \"Player\":
		player_near = false
		helper.nointeract()



"

